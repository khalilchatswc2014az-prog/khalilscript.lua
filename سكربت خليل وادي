end)

local function stopFly()
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
end

bind(RunService.Heartbeat, function()
    if not State.fly then
        if flyBV or flyBG then stopFly() end
        return
    end
    local hrp = getHRP()
    if not hrp then return end
    if not flyBV then
        flyBV = Instance.new("BodyVelocity", hrp)
        flyBV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        flyBV.Velocity = Vector3.zero
    end
    if not flyBG then
        flyBG = Instance.new("BodyGyro", hrp)
        flyBG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        flyBG.P = 10000
    end
    local cam = workspace.CurrentCamera
    local move = Vector3.zero
    if UserInputService:IsKeyDown(Enum.KeyCode.W) then move += cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.S) then move -= cam.CFrame.LookVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.A) then move -= cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.D) then move += cam.CFrame.RightVector end
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then move += Vector3.new(0, 1, 0) end
    flyBV.Velocity = move * 60
    flyBG.CFrame = cam.CFrame
end)

bind(RunService.Heartbeat, function()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                if State.hitbox then
                    if not OriginalHRPTransparency[p] then
                        OriginalHRPTransparency[p] = hrp.Transparency
                        OriginalHRPSize[p] = hrp.Size
                    end
                    local targetSize = Vector3.new(Values.hitboxSize, Values.hitboxSize, Values.hitboxSize)
                    if hrp.Size ~= targetSize then
                        hrp.Size = targetSize
                        hrp.Transparency = 0.5
                        hrp.CanCollide = false
                    end
                else
                    if OriginalHRPTransparency[p] then
                        hrp.Transparency = OriginalHRPTransparency[p]
                        hrp.Size = OriginalHRPSize[p] or Vector3.new(2, 2, 1)
                        hrp.CanCollide = false
                        OriginalHRPTransparency[p] = nil
                        OriginalHRPSize[p] = nil
                    end
                end
            end
        end
    end
end)

