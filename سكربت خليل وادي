local function findFinishPosition()
    local nameCandidates = {"Finish", "FinishLine", "End", "EndPart", "Goal", "Exit", "Final", "FinalLine", "EndZone"}
    for _, name in ipairs(nameCandidates) do
        local part = workspace:FindFirstChild(name, true)
        if part and part:IsA("BasePart") then return part.Position end
    end
    local furthest, furthestDist = nil, -1
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if myHrp then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    local d = (hrp.Position - myHrp.Position).Magnitude
                    if d > furthestDist then
                        furthestDist = d
                        furthest = hrp.Position
                    end
                end
            end
        end
    end
    return furthest
end

local function doTeleport()
    local char = LocalPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local target = findFinishPosition()
    local newCF
    if target then
        newCF = CFrame.new(target + Vector3.new(0, 5, -10))
    else
        local dir = hrp.CFrame.LookVector
        newCF = hrp.CFrame + dir * 250 + Vector3.new(0, 30, 0)
    end
    hrp.CFrame = newCF
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end

TpBtn.MouseButton1Click:Connect(doTeleport)

