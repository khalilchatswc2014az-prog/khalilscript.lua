-- 🧹 التنظيف
-- ═══════════════════════════════════════════════════════════════
_G.KhalilCleanup = function()
    pcall(disableGod)
    pcall(disableNoClip)
    pcall(disableGhost)
    pcall(disableInfJump)
    pcall(disableAirWalk)
    for _, t in ipairs(Threads) do
        if coroutine.status(t) ~= "dead" then pcall(task.cancel, t) end
    end
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    Threads = {}
    Connections = {}
    pcall(function() ScreenGui:Destroy() end)
    print("[Khalil UI] ✅ Cleanup done")
end

