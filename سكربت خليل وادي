-- ═══════════════════════════════════════════════════════════════
-- 🎯 الحالة العامة
-- ═══════════════════════════════════════════════════════════════
local State = {
    God      = false,
    NoClip   = false,
    Ghost    = false,
    InfJump  = false,
    AirWalk  = false,
}

local Connections = {}
local Threads     = {}

local function addConn(c) table.insert(Connections, c) return c end
local function addThread(t) table.insert(Threads, t) return t end

-- ═══════════════════════════════════════════════════════════════
-- 👤 كاش أجزاء الشخصية (لتسريع الحلقة)
-- ═══════════════════════════════════════════════════════════════
local charParts = {}

local function rebuildCache()
    charParts = {}
    local char = LocalPlayer.Character
    if not char then return end
    for _, d in ipairs(char:GetDescendants()) do
        if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture")
            or d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
            table.insert(charParts, d)
        end
    end
end

local function refreshCharPart(d)
    if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture")
        or d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
        table.insert(charParts, d)
    end
end

-- ═══════════════════════════════════════════════════════════════
-- 🛡️ God Mode
-- ═══════════════════════════════════════════════════════════════
local godData = { healthConn = nil, diedConn = nil }

local function applyGodToChar(char)
    if not char or not char.Parent then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    pcall(function()
        hum.MaxHealth = math.huge
        hum.Health = math.huge
        hum.BreakJointsOnDeath = false
        hum.RequiresNeck = false
    end)

    if godData.healthConn then pcall(function() godData.healthConn:Disconnect() end) end
    if godData.diedConn   then pcall(function() godData.diedConn:Disconnect() end)   end

    godData.healthConn = hum.HealthChanged:Connect(function(hp)
        if State.God and hum.Parent and hp < hum.MaxHealth then
            pcall(function() hum.Health = hum.MaxHealth end)
        end
    end)
    addConn(godData.healthConn)

    godData.diedConn = hum.Died:Connect(function()
        if State.God and char.Parent then
            local newHum = char:FindFirstChildOfClass("Humanoid")
            if newHum then
                pcall(function()
                    newHum.MaxHealth = math.huge
                    newHum.Health = math.huge
                end)
            end
        end
    end)
    addConn(godData.diedConn)
end

local function enableGod()
    State.God = true
    applyGodToChar(LocalPlayer.Character)
end

local function disableGod()
    State.God = false
    if godData.healthConn then pcall(function() godData.healthConn:Disconnect() end) end
    if godData.diedConn   then pcall(function() godData.diedConn:Disconnect() end)   end
    local char = LocalPlayer.Character
    if char and char.Parent then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then pcall(function() hum.MaxHealth = 100 hum.Health = 100 end) end
    end
end

-- ═══════════════════════════════════════════════════════════════
-- 👻 NoClip
-- ═══════════════════════════════════════════════════════════════
local function enableNoClip() State.NoClip = true end

local function disableNoClip()
    State.NoClip = false
    local char = LocalPlayer.Character
    if char and char.Parent then
        for _, p in ipairs(charParts) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                pcall(function() p.CanCollide = true end)
            end
        end
    end
end

-- ═══════════════════════════════════════════════════════════════
-- 🌫️ Ghost Mode
-- ═══════════════════════════════════════════════════════════════
local function enableGhost() State.Ghost = true end

local function disableGhost()
    State.Ghost = false
    local char = LocalPlayer.Character
    if char and char.Parent then
        for _, p in ipairs(charParts) do
            if p:IsA("BasePart") then
                pcall(function() p.Transparency = 0 p.LocalTransparencyModifier = 0 end)
            elseif p:IsA("Decal") or p:IsA("Texture") then
                pcall(function() p.Transparency = 0 end)
            elseif p:IsA("BillboardGui") or p:IsA("SurfaceGui") then
                pcall(function() p.Enabled = true end)
            end
        end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            pcall(function()
                hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
                hum.NameDisplayDistance = 100
                hum.HealthDisplayDistance = 100
            end)
        end
    end
end

-- ═══════════════════════════════════════════════════════════════
-- 🦘 Infinite Jump
-- ═══════════════════════════════════════════════════════════════
local infJumpConn = nil
local lastJump = 0

local function enableInfJump()
    State.InfJump = true
    if infJumpConn then pcall(function() infJumpConn:Disconnect() end) end
    infJumpConn = UIS.JumpRequest:Connect(function()
        if not State.InfJump then return end
        local now = tick()
        if now - lastJump < 0.1 then return end
        local char = LocalPlayer.Character
        if not char or not char.Parent then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end
        lastJump = now
        pcall(function()
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end)
    end)
    addConn(infJumpConn)
end

local function disableInfJump()
    State.InfJump = false
    if infJumpConn then
        pcall(function() infJumpConn:Disconnect() end)
        infJumpConn = nil
    end
end

-- ═══════════════════════════════════════════════════════════════
-- 🚶‍♂️ Air Walk
-- ═══════════════════════════════════════════════════════════════
local airData = { bv = nil, bg = nil, speed = 55 }

local function destroyAirWalk()
    if airData.bv then pcall(function() airData.bv:Destroy() end) airData.bv = nil end
    if airData.bg then pcall(function() airData.bg:Destroy() end) airData.bg = nil end
end

local function createAirWalk()
    destroyAirWalk()
    local char = LocalPlayer.Character
    if not char or not char.Parent then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local bv = Instance.new("BodyVelocity")
    bv.Name = "KhalilAW_V"
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    bv.P = 1250
    bv.Parent = hrp

    local bg = Instance.new("BodyGyro")
    bg.Name = "KhalilAW_G"
    bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bg.P = 3000
    bg.D = 500
    bg.CFrame = hrp.CFrame
    bg.Parent = hrp

    airData.bv = bv
    airData.bg = bg
end

local function enableAirWalk()
    State.AirWalk = true
    createAirWalk()
end

local function disableAirWalk()
    State.AirWalk = false
    destroyAirWalk()
end

-- ═══════════════════════════════════════════════════════════════
-- 🔁 الحلقة الرئيسية (RenderStepped = أسرع من Heartbeat)
-- ═══════════════════════════════════════════════════════════════
local mainLoop = task.spawn(function()
    while true do
        RunService.RenderStepped:Wait()
        local char = LocalPlayer.Character
        if char and char.Parent then
            local hum = char:FindFirstChildOfClass("Humanoid")

            -- 🛡️ God
            if State.God and hum then
                if hum.MaxHealth ~= math.huge then
                    pcall(function() hum.MaxHealth = math.huge end)
                end
                if hum.Health < hum.MaxHealth then
                    pcall(function() hum.Health = hum.MaxHealth end)
                end
            end

            -- 👻 NoClip + 🌫️ Ghost (معاً في حلقة واحدة = أسرع)
            if State.NoClip or State.Ghost then
                for _, p in ipairs(charParts) do
                    if p.Parent then
                        if p:IsA("BasePart") then
                            if State.NoClip and p.CanCollide then
                                pcall(function() p.CanCollide = false end)
                            end
                            if State.Ghost and p.Transparency ~= 1 then
                                pcall(function() p.Transparency = 1 end)
                            end
                        elseif State.Ghost then
                            if (p:IsA("Decal") or p:IsA("Texture")) and p.Transparency ~= 1 then
                                pcall(function() p.Transparency = 1 end)
                            elseif (p:IsA("BillboardGui") or p:IsA("SurfaceGui")) and p.Enabled then
                                pcall(function() p.Enabled = false end)
                            end
                        end
                    end
                end
            end

            -- 🚶‍♂️ Air Walk
            if State.AirWalk and airData.bv and airData.bg then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local cam = workspace.CurrentCamera
                if hrp and cam then
                    local moveDir = hum and hum.MoveDirection or Vector3.zero
                    local y = 0
                    if UIS:IsKeyDown(Enum.KeyCode.Space) then y = 25 end
                    if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then y = -25 end
                    airData.bv.Velocity = Vector3.new(
                        moveDir.X * airData.speed, y, moveDir.Z * airData.speed
                    )
                    airData.bg.CFrame = cam.CFrame
                end
            end
        else
            -- إعادة إنشاء AirWalk عند respawn
            if State.AirWalk and not airData.bv then
                task.wait(0.5)
                createAirWalk()
            end
        end
    end
end)
addThread(mainLoop)

-- ═══════════════════════════════════════════════════════════════
-- 🔄 إعادة الظهور
-- ═══════════════════════════════════════════════════════════════
local respawnConn = LocalPlayer.CharacterAdded:Connect(function(char)
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    char:WaitForChild("HumanoidRootPart", 5)
    task.wait(0.2)

    rebuildCache()

    -- راقب الأجزاء الجديدة
    addConn(char.DescendantAdded:Connect(function(d)
        refreshCharPart(d)
        if State.NoClip and d:IsA("BasePart") then
            pcall(function() d.CanCollide = false end)
        end
        if State.Ghost then
            if d:IsA("BasePart") or d:IsA("Decal") or d:IsA("Texture") then
                pcall(function() d.Transparency = 1 end)
            elseif d:IsA("BillboardGui") or d:IsA("SurfaceGui") then
                pcall(function() d.Enabled = false end)
            end
        end
    end))

    if State.God then applyGodToChar(char) end
    if State.AirWalk then task.wait(0.3) createAirWalk() end
end)
addConn(respawnConn)

if LocalPlayer.Character then
    rebuildCache()
    -- راقب الأجزاء الجديدة في الشخصية الحالية
    addConn(LocalPlayer.Character.DescendantAdded:Connect(function(d)
        refreshCharPart(d)
    end))
end

