local function resolveImage(img)
    if not img or img == "" then return "" end
    if img:sub(1, 10) == "rbxassetid" or img:sub(1, 9) == "rbxasset:" then
        return img
    end
    if getcustomasset and isfile then
        local ok, exists = pcall(isfile, img)
        if ok and exists then
            local ok2, asset = pcall(getcustomasset, img)
            if ok2 and asset then return asset end
        end
    end
    return img
end
