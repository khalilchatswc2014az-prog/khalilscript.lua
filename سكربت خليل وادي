bind(RunService.Heartbeat, function()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if State.speed and hum.WalkSpeed ~= Values.runSpeed then
        hum.WalkSpeed = Values.runSpeed
    end

    if State.god and hum.Health < hum.MaxHealth then
        hum.Health = hum.MaxHealth
    end

    if State.alwaysHero then
        local attrs = {"Killer", "IsKiller", "Infected", "Zombie", "IsZombie", "IsTagged", "IsIt", "Role", "PlayerRole"}
        for _, attr in ipairs(attrs) do
            local ok, val = pcall(function() return LocalPlayer:GetAttribute(attr) end)
            if ok and val ~= nil then
                if val == true then
                    pcall(function() LocalPlayer:SetAttribute(attr, false) end)
                elseif type(val) == "string" then
                    local lv = val:lower()
                    if lv:find("kill") or lv:find("zomb") or lv:find("infect") or lv:find("tag") then
                        pcall(function() LocalPlayer:SetAttribute(attr, "Hero") end)
                    end
                end
            end
        end

        for _, attr in ipairs(attrs) do
            local ok, val = pcall(function() return char:GetAttribute(attr) end)
            if ok and val == true then
                pcall(function() char:SetAttribute(attr, false) end)
            end
        end

        local ls = LocalPlayer:FindFirstChild("leaderstats")
        if ls then
            for _, child in ipairs(ls:GetChildren()) do
                local n = child.Name:lower()
                if n:find("kill") or n:find("zomb") or n:find("infect") or n:find("tag") then
                    if child:IsA("BoolValue") and child.Value then
                        pcall(function() child.Value = false end)
                    elseif child:IsA("StringValue") then
                        local cv = child.Value:lower()
                        if cv:find("kill") or cv:find("zomb") or cv:find("infect") or cv:find("tag") then
                            pcall(function() child.Value = "Hero" end)
                        end
                    end
                end
            end
        end

        if LocalPlayer.Team then
            local tn = LocalPlayer.Team.Name:lower()
            if tn:find("kill") or tn:find("zomb") or tn:find("infect") or tn:find("tag") then
                for _, team in ipairs(Teams:GetTeams()) do
                    local htn = team.Name:lower()
                    if htn:find("hero") or htn:find("human") or htn:find("survivor") or htn:find("runner") then
                        pcall(function() LocalPlayer.Team = team end)
                        break
                    end
                end
            end
        end
    end
end)

bind(UserInputService.JumpRequest, function()
    if State.infJump then
        local char = LocalPlayer.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
