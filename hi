        if input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseButton1 then
            activate(input)
        end
    end)
    b.InputEnded:Connect(function(input)
        if input == activeInput then deactivate() end
    end)
    b.MouseLeave:Connect(function()
        if not hasTouch then deactivate() end
    end)

    table.insert(dPadButtons, {
        button = b, key = key, original = original,
        activeInput = function() return activeInput end,
        deactivate = deactivate
    })
    return b
end

