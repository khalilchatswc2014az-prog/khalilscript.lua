-- 📷 Camera Bind (Adaptive with guard)
-- ═══════════════════════════════════════════════════════════════
local cameraTouch = false
local cameraBindings = {}
local cameraBindPending = false

local function unbindCamera()
    for _, c in ipairs(cameraBindings) do
        pcall(function() c:Disconnect() end)
    end
    cameraBindings = {}
end

local function bindCamera()
    if isShuttingDown then return end
    if not ScreenGui or not ScreenGui.Parent then return end
    if cameraBindPending then return end
    cameraBindPending = true
    task.defer(function()
        cameraBindPending = false
        if isShuttingDown then return end
        unbindCamera()
        local cam = workspace.CurrentCamera
        if not cam then return end
        pcall(function()
            table.insert(cameraBindings, cam.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then
                    cameraTouch = true
                end
            end))
            table.insert(cameraBindings, cam.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch then
                    cameraTouch = false
                end
            end))
        end)
    end)
end

