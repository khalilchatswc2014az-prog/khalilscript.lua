local function isPointOnButton(x, y)
    if not Main or not Main.Visible or not Main.Parent then
        -- فحص D-Pad فقط
        if DPadGui and DPadGui.Enabled and DPad and DPad.Parent then
            local dp = DPad.AbsolutePosition
            local ds = DPad.AbsoluteSize
            if x >= dp.X and x <= dp.X + ds.X and y >= dp.Y and y <= dp.Y + ds.Y then
                return true
            end
        end
        return false
    end
    local pos = Main.AbsolutePosition
    local size = Main.AbsoluteSize
    if x >= pos.X and x <= pos.X + size.X and y >= pos.Y and y <= pos.Y + size.Y then
        return true
    end
    if DPadGui and DPadGui.Enabled and DPad and DPad.Parent then
        local dp = DPad.AbsolutePosition
        local ds = DPad.AbsoluteSize
        if x >= dp.X and x <= dp.X + ds.X and y >= dp.Y and y <= dp.Y + ds.Y then
            return true
        end
    end
    return false
end

