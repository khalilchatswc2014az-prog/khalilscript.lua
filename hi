            local char = LocalPlayer.Character
            if not char then return end
            local root = char:FindFirstChild("HumanoidRootPart")
            if not root then return end
            for ball in pairs(activeBalls) do
                if ball and ball.Parent and ball:IsA("BasePart") then
                    local d = (ball.Position - root.Position).Magnitude
                    if d <= 30 and d > 0.1 then
                        ball.Velocity = (root.Position - ball.Position).Unit * 150
                    end
                else
                    activeBalls[ball] = nil
                end
            end
        end, 0.05)
    else
        stopBallCache()
    end
end, true)

