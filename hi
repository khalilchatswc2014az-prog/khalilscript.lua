-- ⚽ فلتر الكرة (Adaptive Pattern)
-- ═══════════════════════════════════════════════════════════════
local function isBall(obj)
    if not obj or not obj.Parent or not obj:IsA("BasePart") then return false end
    local n = obj.Name:lower()
    -- Direct names
    if n == "ball" or n == "football" or n == "soccerball" 
       or n == "disc" or n == "puck" or n == "soccer" then return true end
    -- Pattern matching لأي اسم يحتوي "ball" أو "disc"
    if n:match("ball") and not n:match("balloon") and not n:match("ballast") then return true end
    if n:match("^disc_%d+$") or n:match("^puck_%d+$") then return true end
    return false
end

-- ═══════════════════════════════════════════════════════════════
-- 🎯 Target Getter (adaptive)
-- ═══════════════════════════════════════════════════════════════
local function getAimTarget()
    local myChar = LocalPlayer.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    -- Ball أولاً
    local closestBall, ballDist = nil, math.huge
    for _, d in ipairs(workspace:GetDescendants()) do
        if isBall(d) then
            local dist = (d.Position - myRoot.Position).Magnitude
            if dist < ballDist and dist < 100 then
                ballDist = dist
                closestBall = d
            end
        end
    end
    if closestBall then return closestBall end

    -- Fallback: أقرب لاعب
    local closest, shortest = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Parent and plr.Character then
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local d = (root.Position - myRoot.Position).Magnitude
                if d < shortest then
                    shortest = d
                    closest = root
                end
            end
        end
    end
    return closest
end

