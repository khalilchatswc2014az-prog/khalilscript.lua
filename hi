local function logErr(ctx, err)
    warn("[Khalil UI] ⚠️ " .. ctx .. ": " .. tostring(err))
end

local function track(conn)
    if isShuttingDown then
        if conn then pcall(function() conn:Disconnect() end) end
        return conn
    end
    if conn then table.insert(trackedConns, conn) end
    return conn
end

local function disconnectAll()
    isShuttingDown = true
    for _, c in ipairs(trackedConns) do
        pcall(function() c:Disconnect() end)
    end
    trackedConns = {}
end

-- ✅ يحمي أي loop من الفشل المتكرر
local function guardedLoop(name, feature, fn, waitTime)
    task.spawn(function()
        local errCount = 0
        while vars[feature] and not isShuttingDown do
            local ok, err = pcall(fn)
            if not ok then
                errCount = errCount + 1
                if errCount >= 5 then
                    logErr(name .. " auto-disabled", err)
                    vars[feature] = false
                    break
                end
            else
                errCount = 0
            end
            task.wait(waitTime or 0.1)
        end
    end)
end

