local flyBV, flyBG, flyLoop = nil, nil, nil
local flyStarting = false

local function startFly()
    if flyStarting or isShuttingDown then return end
    flyStarting = true
    pcall(function()
        local char = LocalPlayer.Character
        if not char then flyStarting = false return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then flyStarting = false return end

        for _, o in ipairs(root:GetChildren()) do
            if o.Name == "KhalilFlyBV" or o.Name == "KhalilFlyBG" then
                pcall(function() o:Destroy() end)
            end
        end

        flyBV = Instance.new("BodyVelocity")
        flyBV.Name = "KhalilFlyBV"
        flyBV.MaxForce = Vector3.new(1e6, 1e6, 1e6)
        flyBV.Velocity = Vector3.new(0, 0, 0)
        flyBV.Parent = root

        flyBG = Instance.new("BodyGyro")
        flyBG.Name = "KhalilFlyBG"
        flyBG.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
        flyBG.P = 10000
        flyBG.CFrame = root.CFrame
        flyBG.Parent = root

        if flyLoop then pcall(function() flyLoop:Disconnect() end) end
        flyLoop = RunService.RenderStepped:Connect(function()
            if not vars.fly or isShuttingDown then return end
            pcall(function()
                local c = LocalPlayer.Character
                if not c or not c.Parent then return end
                local r = c:FindFirstChild("HumanoidRootPart")
                if not r or not r.Parent then return end
                if not flyBV or not flyBV.Parent then return end
                if not flyBG or not flyBG.Parent then return end

                local cam = workspace.CurrentCamera
                if not cam then return end
                local move = Vector3.new(0, 0, 0)
                if flyMove.forward  then move = move + cam.CFrame.LookVector end
                if flyMove.backward then move = move - cam.CFrame.LookVector end
                if flyMove.left     then move = move - cam.CFrame.RightVector end
                if flyMove.right    then move = move + cam.CFrame.RightVector end
                if flyMove.up       then move = move + Vector3.new(0, 1, 0) end
                if flyMove.down     then move = move - Vector3.new(0, 1, 0) end

                flyBV.Velocity = move * flySpeed
                flyBG.CFrame = cam.CFrame
            end)
        end)
    end)
    flyStarting = false
end

local function stopFly()
    pcall(function() if flyBV then flyBV:Destroy() end end)
    pcall(function() if flyBG then flyBG:Destroy() end end)
    pcall(function() if flyLoop then flyLoop:Disconnect() end end)
    flyBV, flyBG, flyLoop = nil, nil, nil
    for k in pairs(flyMove) do flyMove[k] = false end
    for _, info in ipairs(dPadButtons) do
        pcall(function() info.deactivate() end)
    end
end

