local function createButton(text, yPos, onClick, isToggle, height)
    height = height or 44
    local btn = Instance.new("TextButton", ButtonsFrame)
    btn.Size = UDim2.new(1, -20, 0, height)
    btn.Position = UDim2.fromOffset(10, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(22, 22, 30)
    btn.Text = text
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = math.floor(13 * UI_SCALE)
    btn.TextColor3 = Color3.fromRGB(240, 240, 240)
    btn.BorderSizePixel = 0
    btn.AutoButtonColor = false
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 10)

    local s = Instance.new("UIStroke", btn)
    s.Color = Color3.fromRGB(40, 40, 55)
    s.Thickness = 1.5

    local lastClick = 0
    local toggled = false

    local function handle()
        if isShuttingDown then return end
        if tick() - lastClick < 0.3 then return end
        lastClick = tick()
        if isToggle then
            toggled = not toggled
            s.Color = toggled and Color3.fromRGB(0, 200, 80) or Color3.fromRGB(40, 40, 55)
            btn.BackgroundColor3 = toggled and Color3.fromRGB(20, 35, 25) or Color3.fromRGB(22, 22, 30)
            if onClick then
                local ok, err = pcall(onClick, toggled)
                if not ok then logErr("Button " .. text, err) end
            end
        else
            if onClick then
                local ok, err = pcall(onClick)
                if not ok then logErr("Button " .. text, err) end
            end
        end
    end

    btn.MouseButton1Click:Connect(handle)
    if hasTouch then
        pcall(function() btn.TouchTap:Connect(handle) end)
    end
    return btn
end

