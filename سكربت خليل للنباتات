local Farm = {
    remotes = {},
    buttons = {},
    plantParts = {},
    guessedRemotes = {},
    lastScan = 0,
}

local function scanRemotes()
    Farm.remotes = {}
    Farm.guessedRemotes = {}
    local folder = ReplicatedStorage:FindFirstChild("Remotes")
    local searchIn = folder or ReplicatedStorage
    for _, v in ipairs(searchIn:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            table.insert(Farm.remotes, v)
            local low = v.Name:lower()
            if low:find("collectfruit") or low:find("fruitpickup") then
                Farm.guessedRemotes.collectFruit = v
            elseif low:find("roll") or low:find("spin") or low:find("shuffle") then
                Farm.guessedRemotes.roll = v
            elseif low:find("steal") or low:find("take") then
                Farm.guessedRemotes.steal = v
            elseif low:find("collect") and low:find("toggle") then
                Farm.guessedRemotes.autoCollect = v
            elseif low:find("plant") and (low:find("place") or low:find("spawn")) then
                Farm.guessedRemotes.plantPlace = v
            elseif low:find("cash") or low:find("money") or low:find("claim") then
                Farm.guessedRemotes.collect = v
            end
        end
    end
end

local function scanButtons()
    Farm.buttons = {}
    for _, gui in ipairs(LocalPlayer.PlayerGui:GetChildren()) do
        for _, b in ipairs(gui:GetDescendants()) do
            if b:IsA("TextButton") or b:IsA("ImageButton") then
                table.insert(Farm.buttons, b)
            end
        end
    end
end

local function scanPlants()
    Farm.plantParts = {}
    local keywords = {"fruit", "plant", "crop", "tree", "harvest", "نبت", "شجرة", "فاكهة"}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") or (obj:IsA("Model") and obj.PrimaryPart) then
            local n = obj.Name:lower()
            for _, kw in ipairs(keywords) do
                if n:find(kw) then
                    table.insert(Farm.plantParts, obj)
                    break
                end
            end
        end
    end
end

local function fullScan()
    scanRemotes()
    scanButtons()
    scanPlants()
    Farm.lastScan = tick()
end

fullScan()

