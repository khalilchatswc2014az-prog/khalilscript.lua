local function addCorner(p, r) local c = Instance.new("UICorner", p) c.CornerRadius = r or UDim.new(0, 10) return c end
local function addStroke(p, col, t)
    local s = Instance.new("UIStroke", p)
    s.Color = col; s.Thickness = t or 2
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
