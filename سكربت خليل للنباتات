local function createFrame(p, pos, size, bg)
    local f = Instance.new("Frame", p)
    f.Position = pos; f.Size = size
    if bg then f.BackgroundColor3 = bg else f.BackgroundTransparency = 1 end
    f.BorderSizePixel = 0
    return f
