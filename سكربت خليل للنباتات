local Remotes = { folder = nil, list = {}, searchDone = false }

local function scanRemotes()
	Remotes.list = {}
	Remotes.searchDone = true
	local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")

	if remotesFolder then
		for _, v in ipairs(remotesFolder:GetDescendants()) do
			if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
				local low = v.Name:lower()
				Remotes.list[v.Name] = v
				-- تصنيف
				if low:find("collectfruit") or low:find("fruitpickup") then
					Remotes.collectFruit = v
				elseif low:find("roll") or low:find("spin") then
					Remotes.roll = v
				elseif low:find("steal") or low:find("take") then
					Remotes.steal = v
				elseif low:find("collect") and low:find("toggle") then
					Remotes.autoCollectToggle = v
				elseif low:find("plant") and low:find("place") then
					Remotes.plantPlace = v
				end
			end
		end
	end
	return Remotes
end

