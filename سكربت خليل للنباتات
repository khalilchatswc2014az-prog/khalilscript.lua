-- ⚡ Anti-Lag (يُعرّف هنا قبل الواجهة)
-- ================================================================================
local LagState = { enabled = false, originals = {}, connections = {} }

local function enableLagReducer()
    if LagState.enabled then return end
    LagState.enabled = true
    LagState.originals = {}
    LagState.originals.Brightness = Lighting.Brightness
    LagState.originals.GlobalShadows = Lighting.GlobalShadows
    LagState.originals.FogEnd = Lighting.FogEnd
    LagState.originals.QualityLevel = settings().Rendering.QualityLevel

    pcall(function() settings().Rendering.QualityLevel = Enum.QualityLevel.Level01 end)

    Lighting.Brightness = 1
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 100
    Lighting.ShadowSoftness = 0

    for _, v in ipairs(Lighting:GetChildren()) do
        if v:IsA("PostEffect") or v:IsA("Atmosphere") then
            if v.Enabled then LagState.originals[v] = true v.Enabled = false end
        end
    end

    LagState.originals.particles = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
            if v.Enabled then LagState.originals.particles[v] = true v.Enabled = false end
        end
    end

    LagState.originals.decals = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if v:IsA("Decal") or v:IsA("Texture") then
            if v.Transparency < 1 then LagState.originals.decals[v] = v.Transparency v.Transparency = 1 end
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do
        if p.Character then
            for _, v in ipairs(p.Character:GetDescendants()) do
                if v:IsA("MeshPart") then v.RenderFidelity = Enum.RenderFidelity.Performance
                elseif v:IsA("Decal") or v:IsA("Texture") then v.Transparency = 1
                elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then v.Enabled = false end
            end
        end
    end

    local sky = Lighting:FindFirstChildOfClass("Sky")
    if sky then LagState.originals.sky = sky LagState.originals.skyParent = sky.Parent sky.Parent = nil end

    local conn = workspace.DescendantAdded:Connect(function(v)
        if not LagState.enabled then return end
        if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
            LagState.originals.particles[v] = true v.Enabled = false
        elseif v:IsA("Decal") or v:IsA("Texture") then
            LagState.originals.decals[v] = v.Transparency v.Transparency = 1
        end
    end)
    table.insert(LagState.connections, conn)
    print("⚡ تم تفعيل تخفيف اللاق")
end

local function disableLagReducer()
    if not LagState.enabled then return end
    LagState.enabled = false
    pcall(function()
        if LagState.originals.QualityLevel then settings().Rendering.QualityLevel = LagState.originals.QualityLevel
        else settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic end
    end)
    Lighting.Brightness = LagState.originals.Brightness or 2
    Lighting.GlobalShadows = LagState.originals.GlobalShadows or true
    Lighting.FogEnd = LagState.originals.FogEnd or 1e5

    if LagState.originals.particles then
        for v, _ in pairs(LagState.originals.particles) do
            if v and v.Parent then pcall(function() v.Enabled = true end) end
        end
    end
    if LagState.originals.decals then
        for v, t in pairs(LagState.originals.decals) do
            if v and v.Parent then pcall(function() v.Transparency = t end) end
        end
    end
    if LagState.originals.sky and LagState.originals.skyParent then
        pcall(function() LagState.originals.sky.Parent = LagState.originals.skyParent end)
    end
    for _, c in ipairs(LagState.connections) do pcall(function() c:Disconnect() end) end
    LagState.connections = {}
    print("🔄 تم إيقاف تخفيف اللاق")
end

