-- ============ Hitbox (مع تنظيف الـ savedSizes) ============
local savedSizes = {}
task.spawn(function()
    while IsAlive do
        task.wait(0.4)
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    if State.hitbox then
                        if savedSizes[hrp] == nil then savedSizes[hrp] = hrp.Size end
                        local s = Values.hitboxSize
                        hrp.Size = Vector3.new(s, s, s)
                        hrp.CanCollide = false; hrp.Massless = true
                    elseif savedSizes[hrp] then
                        hrp.Size = savedSizes[hrp]
                        savedSizes[hrp] = nil
                    end
                end
            end
        end
        -- 🧹 تنظيف HRPs المحذوفة (منع تسرب الذاكرة)
        for hrp, _ in pairs(savedSizes) do
            if not hrp or not hrp.Parent then
                savedSizes[hrp] = nil
            end
        end
