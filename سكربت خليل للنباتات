-- البحث عن زر بالاسم
local function findButton(keywords)
	if type(keywords) == "string" then keywords = {keywords} end
	for _, gui in ipairs(plr.PlayerGui:GetChildren()) do
		for _, b in ipairs(gui:GetDescendants()) do
			if b:IsA("TextButton") or b:IsA("ImageButton") then
				local name = b.Name:lower()
				local txt = (b.Text or ""):lower()
				for _, kw in ipairs(keywords) do
					if name:find(kw:lower()) or txt:find(kw:lower()) then
						if b.Visible and b.Active then
							return b
						end
					end
				end
			end
		end
	end
end

-- الضغط على زر (بدون تريغر الفعل المزدوج)
local function pressButton(btn)
	if not btn or not btn.Parent then return false end
	local ok = pcall(function()
		btn:Activate()  -- أسرع وأأمن من MouseButton1Click
	end)
	if not ok then
		pcall(function()
			local events = {"MouseButton1Click", "Activated"}
			for _, ev in ipairs(events) do
				if btn[ev] then btn[ev]:Fire() end
			end
		end)
	end
	return true
end

-- البحث عن الـ Remotes المشبوهة
local foundRemotes = {}
local function scanRemotes()
	foundRemotes = {}
	local RS_ = game:GetService("ReplicatedStorage")
	for _, v in ipairs(RS_:GetDescendants()) do
		if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
			local n = v.Name:lower()
			if n:find("roll") or n:find("spin") then
				foundRemotes.roll = foundRemotes.roll or v
			elseif n:find("steal") or n:find("take") then
				foundRemotes.steal = foundRemotes.steal or v
			elseif n:find("collect") or n:find("cash") or n:find("money") or n:find("claim") then
				foundRemotes.collect = foundRemotes.collect or v
			elseif n:find("plant") or n:find("pot") or n:find("seed") then
				foundRemotes.plant = foundRemotes.plant or v
			end
		end
	end
end
