function firetouch(part, humanoid)
	if not part or not humanoid then return end
	pcall(function()
		for _, d in ipairs(part:GetChildren()) do
			if d:IsA("TouchTransmitter") then
				firetouch(part, humanoid)
			end
		end
	end)
end

