UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	if not S.fly then return end
	if i.KeyCode == Enum.KeyCode.Space then flyUp = true end
	if i.KeyCode == Enum.KeyCode.LeftControl or i.KeyCode == Enum.KeyCode.RightControl then flyDown = true end
end)
UIS.InputEnded:Connect(function(i)
	if i.KeyCode == Enum.KeyCode.Space then flyUp = false end
	if i.KeyCode == Enum.KeyCode.LeftControl or i.KeyCode == Enum.KeyCode.RightControl then flyDown = false end
end)

