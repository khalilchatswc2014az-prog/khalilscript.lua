-- 9) Auto Steal — يطير للنباتات ويسرقها
-- ═══════════════════════════════════════════════════════════
local function getNearestFruit()
	local root = rt()
	if not root then return nil end
	local best, bestD = nil, cfg.stealRange
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") or (obj:IsA("Model") and obj.PrimaryPart) then
			local n = obj.Name:lower()
			if n:find("fruit") or n:find("plant") or n:find("crop")
			or n:find("tree") or n:find("harvest") or n:find("نبت") then
				local pos = obj:IsA("BasePart") and obj.Position
					or (obj.PrimaryPart and obj.PrimaryPart.Position)
				if pos then
					local d = dist(pos, root.Position)
					if d < bestD then best, bestD = obj, d end
				end
			end
		end
	end
	return best
end

local function tpTo(target)
	local root = rt()
	if not root or not target then return end
	local pos = target:IsA("BasePart") and target.Position
		or (target.PrimaryPart and target.PrimaryPart.Position)
	if not pos then return end

	if cfg.tpSmooth then
		-- تحريك سلس لتقليل كشف الأنظمة
		local goal = CFrame.new(pos + Vector3.new(0, 3, 0))
		root.CFrame = root.CFrame:Lerp(goal, 0.5)
	else
		root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
	end
end

task.spawn(function()
	while true do
		task.wait(cfg.autoStealDelay)
		if S.autoSteal then
			local target = getNearestFruit()
			if target then
				tpTo(target)
				statusLabel.Text = "🌱 سرقة: " .. target.Name
				statusLabel.TextColor3 = Color3.fromRGB(255, 100, 200)

				-- لمس الجزء لجعله يطلق TouchTransmitter
				local h = hu()
				if target:IsA("BasePart") then safeTouch(target, h) end

				-- تشغيل ProximityPrompt إن وجد
				for _, p in ipairs(target:GetDescendants()) do
					if p:IsA("ProximityPrompt") then firePrompt(p) end
				end

				-- محاولة إرسال Remote السرقة
				if Remotes.steal then
					pcall(function() Remotes.steal:FireServer(target) end)
				end
				if Remotes.collectFruit then
