-- 10) ESP
-- ═══════════════════════════════════════════════════════════
local function createESP(obj, color)
	if not obj or not obj.Parent or espBoxes[obj] then return end
	local adornee = obj:IsA("BasePart") and obj or obj.PrimaryPart
	if not adornee then
		local ok, pivot = pcall(function() return obj:GetPivot() end)
		if not ok then return end
		-- إنشاء Part مؤقت
		local tmp = Instance.new("Part")
		tmp.Anchored = true
		tmp.CanCollide = false
		tmp.Transparency = 1
		tmp.Size = Vector3.new(2, 2, 2)
		tmp.CFrame = pivot
		tmp.Parent = g
		adornee = tmp
	end
	local size = adornee.Size or Vector3.new(3, 3, 3)
	local box = Instance.new("BoxHandleAdornment")
	box.Size = size + Vector3.new(0.5, 0.5, 0.5)
	box.Adornee = adornee
	box.AlwaysOnTop = true
	box.ZIndex = 5
	box.Transparency = 0.6
	box.Color3 = color
	box.Parent = g
	espBoxes[obj] = box
end

local function clearESP()
	for _, box in pairs(espBoxes) do
		if box and box.Parent then box:Destroy() end
	end
	espBoxes = {}
end

task.spawn(function()
	while true do
		task.wait(0.8)
		local anyESP = S.espPlants or S.espPlayers or S.espPets
		if anyESP then
			if S.espPlants then
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("BasePart") or (obj:IsA("Model") and obj.PrimaryPart) then
						local n = obj.Name:lower()
						if n:find("fruit") or n:find("plant") or n:find("crop") or n:find("نبت") then
							createESP(obj, Color3.fromRGB(0, 255, 100))
						end
					end
				end
			end
			if S.espPlayers then
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= plr and p.Character then
						local hrp = p.Character:FindFirstChild("HumanoidRootPart")
						if hrp then createESP(hrp, Color3.fromRGB(255, 100, 100)) end
					end
				end
			end
			if S.espPets then
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
						local n = obj.Name:lower()
						if n:find("pet") or n:find("حيوان") then
							createESP(obj, Color3.fromRGB(100, 200, 255))
						end
					end
				end
			end
		else
			if next(espBoxes) then clearESP() end
		end
	end
end)

