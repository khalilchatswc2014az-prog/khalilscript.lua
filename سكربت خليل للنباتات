-- touch آمن — يستدعي TouchTransmitter فقط
local function safeTouch(part, humanoid)
	if not part or not part.Parent or not humanoid then return end
	pcall(function()
		for _, d in ipairs(part:GetChildren()) do
			if d:IsA("TouchTransmitter") then
				-- TouchTransmitter يُطلق تلقائياً عند لمس Part
				-- الحل: نحرك الشخصية قربها فقط
				break
			end
		end
	end)
end

-- ProximityPrompt آمن
local function firePrompt(prompt)
	if not prompt or not prompt.Parent then return end
	pcall(function()
		local hold = prompt.HoldDuration or 0
		prompt:InputHoldBegin()
		if hold > 0 then task.wait(hold) end
		prompt:InputHoldEnd()
	end)
end

-- البحث عن زر بالاسم أو النص
local function findButton(keywords)
	if type(keywords) == "string" then keywords = {keywords} end
	for _, gui in ipairs(plr.PlayerGui:GetChildren()) do
		for _, b in ipairs(gui:GetDescendants()) do
			if b:IsA("TextButton") or b:IsA("ImageButton") then
				local name = b.Name:lower()
				local txt = (b.Text or ""):lower()
				for _, kw in ipairs(keywords) do
					local k = kw:lower()
					if (name:find(k) or txt:find(k)) and b.Visible then
						return b
					end
				end
			end
		end
	end
	return nil
end

-- الضغط على زر بأمان
local function pressButton(btn)
	if not btn or not btn.Parent then return false end
	local ok = pcall(function() btn:Activate() end)
	return ok
end

