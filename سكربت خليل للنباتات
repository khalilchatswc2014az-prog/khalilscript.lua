-- 12) ESP — عرض النباتات واللاعبين
-- ═══════════════════════════════════════════════════════════
local function createESP(obj, color, name)
	if not obj or not obj.Parent then return end
	if espFolders[obj] then return end
	local box = Instance.new("BoxHandleAdornment")
	box.Size = obj:IsA("BasePart") and obj.Size or (obj:GetExtentsSize and obj:GetExtentsSize() or Vector3.new(5,5,5))
	box.Adornee = obj:IsA("BasePart") and obj or obj.PrimaryPart
	if not box.Adornee then return end
	box.AlwaysOnTop = true
	box.ZIndex = 5
	box.Transparency = 0.7
	box.Color3 = color
	box.Parent = g
	espFolders[obj] = box
end

local function clearESP()
	for obj, box in pairs(espFolders) do
		if box and box.Parent then box:Destroy() end
	end
	espFolders = {}
end

task.spawn(function()
	while true do
		task.wait(0.5)
		if S.plantESP or S.playerESP then
			if S.plantESP then
				for _, obj in ipairs(workspace:GetDescendants()) do
					if obj:IsA("BasePart") or obj:IsA("Model") then
						local n = obj.Name:lower()
						if n:find("plant") or n:find("crop") or n:find("tree") or n:find("flower") then
							createESP(obj, Color3.fromRGB(0, 255, 100))
						end
					end
				end
			end
			if S.playerESP then
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= plr and p.Character then
						local hrp = p.Character:FindFirstChild("HumanoidRootPart")
						if hrp then createESP(hrp, Color3.fromRGB(255, 100, 100)) end
					end
				end
			end
		else
			if next(espFolders) then clearESP() end
		end
	end
end)

