-- ============ Auto Steal (بدون Teleport + task.spawn للـ prompts) ============
task.spawn(function()
    while IsAlive do
        task.wait(Values.autoStealDelay)
        if State.autoSteal then
            local root = rt()
            if not root then continue end
            local myPos = root.Position

            local closest, closestDist = nil, 60
            for _, obj in ipairs(Farm.plantParts) do
                if obj and obj.Parent then
                    local pos = obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
                    if pos then
                        local d = (pos - myPos).Magnitude
                        if d < closestDist then closest, closestDist = obj, d end
                    end
                end
            end

            if closest then
                -- ✅ كل prompt في task.spawn منفصل عشان ما يوقف اللوب
                for _, d in ipairs(closest:GetDescendants()) do
                    if d:IsA("ProximityPrompt") then
                        task.spawn(function()
                            pcall(function()
                                d:InputHoldBegin()
                                task.wait(math.min(d.HoldDuration or 0, 0.5))
                                d:InputHoldEnd()
                            end)
                        end)
                    end
                end
                if Farm.guessedRemotes.steal then
                    pcall(function() Farm.guessedRemotes.steal:FireServer(closest) end)
                end
                if Farm.guessedRemotes.collectFruit then
                    pcall(function() Farm.guessedRemotes.collectFruit:FireServer(closest) end)
                end
            end
        end
    end
end)

-- ============ ESP (مع تنظيف) ============
local espBoxes = {}

local function createESP(obj, color)
    if not obj or not obj.Parent or espBoxes[obj] then return end
    local adornee = obj:IsA("BasePart") and obj or obj.PrimaryPart
    if not adornee then return end
    local box = Instance.new("BoxHandleAdornment")
    box.Size = adornee.Size + Vector3.new(0.5, 0.5, 0.5)
    box.Adornee = adornee
    box.AlwaysOnTop = true
    box.ZIndex = 5
    box.Transparency = 0.6
    box.Color3 = color
    box.Parent = ScreenGui
    espBoxes[obj] = box
end

local function clearESP()
    for _, box in pairs(espBoxes) do
        if box and box.Parent then box:Destroy() end
    end
    espBoxes = {}
end

-- 🧹 تنظيف الكائنات الميتة
task.spawn(function()
    while IsAlive do
        task.wait(1)
        for obj, box in pairs(espBoxes) do
            if not obj or not obj.Parent then
                if box and box.Parent then box:Destroy() end
                espBoxes[obj] = nil
            end
        end
    end
end)

