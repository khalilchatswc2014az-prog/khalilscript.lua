_G.KhalilCleanup = function()
    IsAlive = false

    if LagState.enabled then pcall(disableLagReducer) end

    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    Connections = {}

    if LagState.connections then
        for _, c in ipairs(LagState.connections) do pcall(function() c:Disconnect() end) end
        LagState.connections = {}
    end

    pcall(clearESP)

    pcall(function()
        if bv then bv:Destroy() bv = nil end
        if bg then bg:Destroy() bg = nil end
        local h = hu()
        if h then h.PlatformStand = false end
    end)

    pcall(function() ScreenGui:Destroy() end)
end

