-- 10) Auto Steal — يطير لقواعد اللاعبين ويسرق النباتات
-- ═══════════════════════════════════════════════════════════
local function getNearestPlant()
	local root = rt()
	if not root then return nil end
	local best, bestDist = nil, cfg.stealRange
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") or obj:IsA("Model") then
			local n = obj.Name:lower()
			if n:find("plant") or n:find("crop") or n:find("tree") or n:find("flower") then
				local pos = obj:IsA("BasePart") and obj.Position or (obj.PrimaryPart and obj.PrimaryPart.Position)
				if pos then
					local d = dist3(pos, root.Position)
					if d < bestDist then
						best, bestDist = obj, d
					end
				end
			end
		end
	end
	return best
end

task.spawn(function()
	while true do
		task.wait(cfg.autoStealDelay)
		if S.autoSteal then
			local target = getNearestPlant()
			local root = rt()
			if target and root then
				local pos = target:IsA("BasePart") and target.Position
					or (target.PrimaryPart and target.PrimaryPart.Position)
				if pos then
					-- Teleport قريب من النبتة
					root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
					statusLabel.Text = "🌱 سرقة: " .. target.Name
					statusLabel.TextColor3 = Color3.fromRGB(255, 100, 200)

					-- محاولة لمس النبتة
					if target:IsA("BasePart") then
						firetouch(target, hu())
					else
						for _, p in ipairs(target:GetDescendants()) do
							if p:IsA("BasePart") then firetouch(p, hu()) end
						end
					end

					-- محاولة تفعيل ProximityPrompt
					for _, p in ipairs(target:GetDescendants()) do
						if p:IsA("ProximityPrompt") then
							fireproximityprompt(p)
						end
					end

					-- محاولة إرسال Remote
					if foundRemotes.steal then
						pcall(function()
							foundRemotes.steal:FireServer(target)
						end)
					end
				end
			else
				statusLabel.Text = "🔍 ما فيه نباتات قريبة"
				statusLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
			end
		end
	end
end)

