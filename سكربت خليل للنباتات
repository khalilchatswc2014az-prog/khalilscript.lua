-- ============ Fly ============
local bv, bg
bind(RunService.RenderStepped, function()
    local h, r = hu(), rt()
    if not State.fly then
        if bv then bv:Destroy() bv = nil end
        if bg then bg:Destroy() bg = nil end
        if h and h.PlatformStand then h.PlatformStand = false end
        return
    end
    if not (r and h) then return end
    if not bv or bv.Parent ~= r then
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
        bv = Instance.new("BodyVelocity", r)
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bg = Instance.new("BodyGyro", r)
        bg.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        bg.P = 9e4
    end
    h.PlatformStand = true
    local dir = h.MoveDirection * Values.flySpeed
    if UserInputService:IsKeyDown(Enum.KeyCode.Space) then dir = dir + Vector3.new(0, Values.flySpeed, 0) end
    if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then
        dir = dir - Vector3.new(0, Values.flySpeed, 0)
    end
    bv.Velocity = dir
    bg.CFrame = workspace.CurrentCamera.CFrame
end)

