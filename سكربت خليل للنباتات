local CONFIG = "KhalilFarm.json"
local DEFAULTS = {
	speed = 80,
	hideKey = "RightShift",
	autoRollDelay = 0.3,
	autoCollectDelay = 0.5,
	autoStealDelay = 0.8,
	stealRange = 400,
	tpSmooth = true,
}

local function clone(t) local r = {} for k, v in pairs(t) do r[k] = v end return r end

local function loadCfg()
	local fb = clone(DEFAULTS)
	if not (writefile and readfile and isfile) then return fb end
	if not isfile(CONFIG) then return fb end
	local ok, data = pcall(function() return HS:JSONDecode(readfile(CONFIG)) end)
	if ok and type(data) == "table" then
		for k, v in pairs(DEFAULTS) do if data[k] == nil then data[k] = v end end
		return data
	end
	return fb
end

local cfg = loadCfg()

local function saveCfg()
	if not writefile then return end
	pcall(function() writefile(CONFIG, HS:JSONEncode(cfg)) end)
end

